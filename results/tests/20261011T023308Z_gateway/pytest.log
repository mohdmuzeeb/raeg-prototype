                                   fence=OwnerFence("w", claim.lease_token))
        with pytest.raises(IllegalTransition):
            await store.transition(key, "T5", worker_id="w", rule_id="x", patch={"fingerprint": "evil"},
                                   fence=OwnerFence("w", claim.lease_token))
